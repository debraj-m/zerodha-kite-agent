# The model key. The first line with a value is the one used. npx @flow-engineer/flow setup writes
# FLOW_KEY, the agent's one Flow key, which calls models on the account's free trial credit, so no
# provider key is needed; your own, made at the provider and pasted on its line, wins over it.
# Never commit this file.
#   OPENROUTER_API_KEY   https://openrouter.ai/keys
#   OPENAI_API_KEY       https://platform.openai.com/api-keys
#   ANTHROPIC_API_KEY    https://console.anthropic.com/settings/keys
#   GEMINI_API_KEY       https://aistudio.google.com/apikey
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FLOW_KEY=

# Optional. The model id for that provider; empty is that provider's default.
# MODEL=

# The test cloud (npx @flow-engineer/flow test --synthetic) and traces. Sign in at https://flow.engineer/observe,
# add the agent, and on its Developers page make a CI key (oci_..., shown once); the trace key is
# from the same site.
FLOW_FRAMEWORK_CLOUD=https://flow.engineer/observe
FLOW_FRAMEWORK_CLOUD_KEY=
FLOW_FRAMEWORK_TRACES_URL=https://flow.engineer/observe
FLOW_FRAMEWORK_TRACES_KEY=

# Zerodha Kite Connect app (https://developers.kite.trade/apps): the API key and secret of YOUR app.
# Never commit .env or paste these anywhere.
KITE_API_KEY=
KITE_API_SECRET=
# Orders are off until this is 1. The limits apply to every order.
KITE_ORDERS_ENABLED=0
KITE_MAX_QUANTITY=10
KITE_MAX_ORDER_VALUE=10000
# Optional but advised: the only WhatsApp number (E.164, +91...) that may use the Zerodha tools. Empty: anyone who
# writes to the agent can. Verified order updates from Zerodha are messaged to the number that signed in.
KITE_ALLOWED_PHONE=

# Bearer token (32+ characters) for the MCP endpoint when it is deployed publicly. Make it long and random.
MCP_TOKEN=
